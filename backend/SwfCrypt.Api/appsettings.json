{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/swfcrypt.db"
  },
  "Storage": {
    "SwfFolder": "data/swf",
    "MaxUploadBytes": 26214400
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Analysis": {
    "MaxAttempts": 3,
    "BaseDelaySeconds": 1,
    "QueueCapacity": 200
  },
  "RateLimit": {
    "AuthPerMinute": 10,
    "UploadPerMinute": 10
  },
  "Seed": {
    "DemoUsers": [
      { "Email": "admin@swfcrypt.demo", "Password": "Demo-Admin-1!", "Role": "Admin" },
      { "Email": "curator@swfcrypt.demo", "Password": "Demo-Curator-1!", "Role": "Curator" },
      { "Email": "member@swfcrypt.demo", "Password": "Demo-Member-1!", "Role": "Member" }
    ]
  }
}
