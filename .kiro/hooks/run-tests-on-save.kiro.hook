{
  "name": "Run xUnit Tests on C# Save",
  "version": "1.0.0",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/**/*.cs"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "dotnet run --project backend/SwfCrypt.Tests/SwfCrypt.Tests.csproj --no-launch-profile"
  }
}
